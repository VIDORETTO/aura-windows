{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura",
  "version": "0.2.0",
  "identifier": "app.aura.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "title": "Aura",
        "url": "index.html#/overlay",
        "width": 640,
        "height": 64,
        "minWidth": 480,
        "minHeight": 64,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/Aura/cache/**",
          "$LOCALDATA/Aura/workspaces/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Aura contributors",
    "shortDescription": "Assistente de IA flutuante para Windows",
    "longDescription": "Aura é um assistente de IA sempre à mão: atalho global, vê a tela quando você permite, ouve, lê anexos e age com ferramentas.",
    "category": "Productivity",
    "copyright": "MIT OR Apache-2.0",
    "externalBin": [
      "binaries/aura-worker"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "binaries/*.dll": "./"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGNjVBNUEzQzZGQzhGN0QKUldSOWovekdvNlZsRDFORWtWOEV3MEhXYU9pem1wT0c1ZTBqd3ZWVkhrdWlmYm5QWVQ0UjZvczYK",
      "endpoints": [
        "https://github.com/VIDORETTO/aura-windows/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
