---
import "../styles/global.css";
import sansFont from "@fontsource/geist-sans/files/geist-sans-latin-600-normal.woff2?url";
import { LATEST_URL, REPO_URL, type Release } from "../lib/release";

interface Props {
  title: string;
  description: string;
  release: Release | null;
}
const { title, description, release } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(base, Astro.site);
const og = new URL(`${base}og.png`, Astro.site);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Aura",
  description,
  applicationCategory: "ProductivityApplication",
  operatingSystem: "Windows 10, Windows 11",
  softwareVersion: release?.version,
  downloadUrl: release?.setup?.url ?? LATEST_URL,
  offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
  license: `${REPO_URL}#licença`,
  url: canonical.href,
  image: og.href,
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#0a0909" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://api.github.com" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Aura" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={og.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aura: sua IA no Windows, a um atalho de distância." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.href} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <slot />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
