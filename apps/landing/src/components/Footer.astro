---
import Logo from "./Logo.astro";
import { REPO_URL } from "../lib/release";

const links = [
  [REPO_URL, "GitHub"],
  [`${REPO_URL}/blob/main/docs/usage.md`, "Guia de uso"],
  [`${REPO_URL}/issues`, "Reportar problema"],
  [`${REPO_URL}/blob/main/SECURITY.md`, "Segurança"],
  [`${REPO_URL}/blob/main/CHANGELOG.md`, "Changelog"],
];
---

<footer>
  <div class="container inner">
    <div class="brand">
      <Logo size={22} />
      <span>Aura</span>
      <span class="sub">Assistente de IA para Windows · MIT ou Apache-2.0</span>
    </div>
    <ul>
      {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-block: 32px 40px;
    font-size: 14px;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    flex-wrap: wrap;
  }
  .sub {
    font-weight: 400;
    color: var(--subtle);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--text);
  }
</style>
