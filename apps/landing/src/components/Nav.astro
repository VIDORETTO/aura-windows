---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { LATEST_URL, type Release } from "../lib/release";

interface Props {
  release: Release | null;
}
const { release } = Astro.props;
const links = [
  ["#recursos", "Recursos"],
  ["#privacidade", "Privacidade"],
  ["#atalhos", "Atalhos"],
  ["#perguntas", "Perguntas"],
];
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <a class="brand" href="#topo" aria-label="Aura, início">
      <Logo size={28} />
      <span>Aura</span>
    </a>
    <nav aria-label="Seções">
      <ul>
        {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-primary nav-cta" href={release?.setup?.url ?? LATEST_URL} data-dl="setup">
      <Icon name="download" size={16} />
      <span>Baixar</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header);
    border-bottom: 1px solid transparent;
    transition:
      background-color 300ms var(--ease),
      border-color 300ms var(--ease),
      backdrop-filter 300ms var(--ease);
  }
  .nav.scrolled {
    background: rgb(10 9 9 / 0.72);
    border-bottom-color: var(--line);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .brand:hover {
    color: var(--text);
  }
  nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 14.5px;
    transition:
      color 200ms var(--ease),
      background-color 200ms var(--ease);
  }
  ul a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.05);
  }
  .nav-cta {
    --h: 38px;
    padding-inline: 16px;
    font-size: 14px;
    gap: 8px;
  }
  @media (max-width: 760px) {
    nav {
      display: none;
    }
    .nav-cta {
      margin-left: auto;
    }
  }
</style>
