---
// Native <details>: works without JS (PLANO.md §4.8).
import { LATEST_URL } from "../lib/release";

const faq: { q: string; a: string }[] = [
  {
    q: "O Aura é gratuito?",
    a: "Sim. O aplicativo é gratuito e de código aberto. O acesso ao modelo depende do plano ChatGPT ou do provedor que você escolher; com um servidor local, não há custo de API.",
  },
  {
    q: "Preciso de uma conta ChatGPT?",
    a: "Não. Você pode entrar com o ChatGPT, usar a chave de um provedor compatível ou apontar para um servidor local, como o Ollama.",
  },
  {
    q: "O Windows mostrou “O Windows protegeu o computador”. É seguro?",
    a: `O instalador ainda não tem um certificado de assinatura de código (Authenticode), então o SmartScreen avisa na primeira execução. Clique em <strong>Mais informações → Executar assim mesmo</strong>. Para conferir o arquivo, compare o SHA-256 mostrado na <a href="#baixar">seção de download</a> com o resultado de <code>Get-FileHash .\\Aura_*_x64-setup.exe</code> no PowerShell. As atualizações feitas pelo próprio Aura são verificadas por assinatura.`,
  },
  {
    q: "Quais são os requisitos?",
    a: "Windows 10 ou 11 de 64 bits (x64) com o WebView2, que já vem no Windows 11. É preciso internet para baixar componentes, usar modelos remotos e pesquisar na web.",
  },
  {
    q: "O que o Aura vê da minha tela?",
    a: "Só o que você permitir. Em Privacidade você escolhe, para tela, microfone e áudio do sistema, se o agente pode usar, se precisa perguntar ou se fica desligado. Janelas excluídas nunca entram, e cada acesso fica registrado.",
  },
  {
    q: "Como atualizo?",
    a: "Em Configurações → Sobre, o Aura procura e instala a nova versão. Você também pode baixar o instalador novamente nesta página.",
  },
  {
    q: "Como desinstalo?",
    a: "Pelo Windows, em Configurações → Aplicativos. Exporte antes o que quiser guardar; os dados ficam em <code>%LOCALAPPDATA%\\Aura</code>.",
  },
  {
    q: "Funciona no macOS ou no Linux?",
    a: `Não. O Aura usa recursos do Windows para atalhos globais, captura de tela e áudio. Acompanhe as novidades nas <a href="${LATEST_URL}">versões do GitHub</a>.`,
  },
];
---

<section class="section" id="perguntas" aria-labelledby="faq-title">
  <div class="container grid">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Perguntas</p>
      <h2 class="title" id="faq-title" data-reveal style="--i:1">Antes de baixar.</h2>
    </div>
    <div class="list">
      {
        faq.map((f, i) => (
          <details data-reveal style={`--i:${i % 4}`}>
            <summary>
              <span>{f.q}</span>
              <span class="pm" aria-hidden="true" />
            </summary>
            <div class="answer">
              <p set:html={f.a} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }
  .list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    font-size: 1.08rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 200ms var(--ease);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--red-300);
  }
  .pm {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .pm::before,
  .pm::after {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--red-400);
    transition: rotate 300ms var(--ease);
  }
  .pm::after {
    rotate: 90deg;
  }
  details[open] .pm::after {
    rotate: 0deg;
  }
  .answer {
    padding: 0 4px 24px;
    color: var(--muted);
    max-width: 68ch;
  }
  details[open] .answer {
    animation: open 400ms var(--ease);
  }
  @keyframes open {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
  }
  .answer :global(strong) {
    color: var(--text);
    font-weight: 500;
  }
  .answer :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text);
    word-break: break-all;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
